/ {
	aliases {
        /*      You can't define an alias for an alias, as the homework asks.
                app-led = &led0; is gonna fail to build.
                my board has led0 defined as this led, so I setted up here, but maybe your board don't have it.
        */
		app-led = &yellow_led1;
	};

	led_sensor0: led_sensor {
		compatible = "led-sensor";
		gpios = <&pioa 23 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};